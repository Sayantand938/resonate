{
  "name": "resonate",
  "version": "0.2.0",
  "description": "Generate songs end-to-end: theme → lyrics → ABC → MIDI → production-ready WAV",
  "type": "module",
  "bin": {
    "resonate": "./bin/cli.mjs"
  },
  "files": [
    "bin/",
    "scripts/",
    "src/",
    "config.yaml",
    "config.local.yaml.example",
    "README.md"
  ],
  "scripts": {
    "list": "node bin/cli.mjs list",
    "install-soundfont": "powershell -ExecutionPolicy Bypass -File scripts/install-soundfont.ps1"
  },
  "keywords": [
    "music",
    "song",
    "abc",
    "abcjs",
    "midi",
    "wav",
    "yue2",
    "llm",
    "openai",
    "fluidsynth",
    "cli"
  ],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.9.1",
  "dependencies": {
    "abcjs": "^6.4.4",
    "chalk": "^6.0.1",
    "cli-table3": "^0.6.5",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "execa": "^10.0.1",
    "js-yaml": "^4.1.0",
    "openai": "^4.77.0"
  }
}