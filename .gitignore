### resonate — pipeline artifacts ###

# Keep song.md, plan.json, and score.abc — they're the source of truth.
# Ignore everything downstream that can be regenerated.

songs/**/score.mid
songs/**/song.wav
songs/**/.score.loud.mid
songs/**/score.mscz
songs/**/.musescore-*.json
songs/**/convert.json
songs/**/*.bak
songs/**/score-meta.mid
songs/**/score.pdf

# Debug / scratch files from pipeline investigations.
yue2_debug_response.json
songs/**/yue2_debug_response.json
songs/**/song-notabc.mid
songs/**/score.normalized.abc
songs/**/debug-normalized.abc
