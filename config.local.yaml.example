# Copy to config.local.yaml and edit. The real file is gitignored.
#
# Anything set here is deep-merged over config.yaml, so you only list the
# keys you want to override. Arrays (like vst3_routing) replace wholesale.

render:
  # "fluidsynth" (default, portable) or "vst3" (needs absolute paths below).
  backend: vst3

  # Each entry maps a set of MIDI channels to a VST3 instrument.
  # Channels not listed are dropped from the render.
  vst3_routing:
    - channels: [0, 1]
      vst3: "C:/Program Files/Common Files/VST3/AGML.vst3/Contents/x86_64-win/AGML.vst3"
      gain: 0.9
    - channels: [2]
      vst3: "C:/Program Files/Common Files/VST3/Audiolatry/Grand Piano.vst3"
      gain: 3.0

  # Pin the humanization seed for reproducible renders.
  # (0 = a fresh random seed on every run.)
  # humanize:
  #   seed: 12345
